# Copy to .env and fill in. Never commit .env.

# replay = offline, LLM calls served from data/cassettes (default; CI and demo use this)
# record = call the real API and write cassettes
# live   = call the real API, no cassettes
DIGEST_MODE=replay

# Which API answers in record and live modes: openrouter (development gateway) or
# anthropic_api (production). live mode requires anthropic_api.
DIGEST_BACKEND=openrouter

# World under data/world used by replay and demo
DIGEST_WORLD=kestrel

# Needed for record/live modes only, for the backend selected above
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Needed for Slack live mode only (Socket Mode, no public URL)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
