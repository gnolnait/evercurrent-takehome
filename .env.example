# Copy to .env and fill in. Never commit .env.

# replay = offline, LLM calls served from data/cassettes (default; CI and demo use this)
# record = call the real API and write cassettes
# live   = call the real API, no cassettes
DIGEST_MODE=replay

# Needed for record/live modes only
ANTHROPIC_API_KEY=

# Needed for Slack live mode only (Socket Mode, no public URL)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
